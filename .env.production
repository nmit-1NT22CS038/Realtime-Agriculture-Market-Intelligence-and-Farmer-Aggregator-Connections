# Production Environment Variables
OPENAI_API_KEY=your_actual_openai_key_here
APP_LLM_ENABLED=true

# Database credentials (strong passwords for production)
MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=agrilink_password
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/agrilink_db
SPRING_DATASOURCE_USERNAME=agrilink_user
SPRING_DATASOURCE_PASSWORD=agrilink_password

# ML Configuration
APP_ML_PYTHON_PATH=python3
APP_ML_RECOMMEND_SCRIPT_PATH=/app/ml/recommend.py
APP_ML_RAINFALL_CSV_PATH=/app/Data/rainfall_master_normalized.csv